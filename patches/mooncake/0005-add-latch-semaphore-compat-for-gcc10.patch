diff --git a/mooncake-store/include/cxx20_sync_compat.h b/mooncake-store/include/cxx20_sync_compat.h
new file mode 100644
index 0000000..0e5c148
--- /dev/null
+++ b/mooncake-store/include/cxx20_sync_compat.h
@@ -0,0 +1,78 @@
+#pragma once
+
+// libstdc++ before GCC 11 has no <latch> / <semaphore>. Provide the subset of
+// std::latch and std::binary_semaphore that Mooncake uses so the store still
+// builds with GCC 10; newer toolchains just alias the standard types.
+
+#if __has_include(<latch>) && __has_include(<semaphore>)
+#include <latch>
+#include <semaphore>
+
+namespace mooncake::compat {
+using std::latch;
+using binary_semaphore = std::binary_semaphore;
+}  // namespace mooncake::compat
+
+#else
+#include <chrono>
+#include <condition_variable>
+#include <cstddef>
+#include <mutex>
+
+namespace mooncake::compat {
+
+class latch {
+   public:
+    explicit latch(std::ptrdiff_t expected) : count_(expected) {}
+    latch(const latch&) = delete;
+    latch& operator=(const latch&) = delete;
+
+    void count_down(std::ptrdiff_t n = 1) {
+        std::lock_guard<std::mutex> lock(mu_);
+        count_ -= n;
+        if (count_ <= 0) cv_.notify_all();
+    }
+
+    void wait() const {
+        std::unique_lock<std::mutex> lock(mu_);
+        cv_.wait(lock, [this] { return count_ <= 0; });
+    }
+
+   private:
+    mutable std::mutex mu_;
+    mutable std::condition_variable cv_;
+    std::ptrdiff_t count_;
+};
+
+class binary_semaphore {
+   public:
+    explicit binary_semaphore(std::ptrdiff_t desired) : available_(desired > 0) {}
+    binary_semaphore(const binary_semaphore&) = delete;
+    binary_semaphore& operator=(const binary_semaphore&) = delete;
+
+    void release() {
+        {
+            std::lock_guard<std::mutex> lock(mu_);
+            available_ = true;
+        }
+        cv_.notify_one();
+    }
+
+    template <class Rep, class Period>
+    bool try_acquire_for(const std::chrono::duration<Rep, Period>& timeout) {
+        std::unique_lock<std::mutex> lock(mu_);
+        if (!cv_.wait_for(lock, timeout, [this] { return available_; })) {
+            return false;
+        }
+        available_ = false;
+        return true;
+    }
+
+   private:
+    std::mutex mu_;
+    std::condition_variable cv_;
+    bool available_;
+};
+
+}  // namespace mooncake::compat
+#endif
