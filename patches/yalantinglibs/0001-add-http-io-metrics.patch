+  void start_io_context_lag_timers() {
+    if (pool_ == nullptr) {
+      return;
+    }
+    io_context_lag_timers_.reserve(pool_->pool_size());
+    for (std::size_t i = 0; i < pool_->pool_size(); ++i) {
+      auto timer = std::make_shared<asio::steady_timer>(
+          pool_->get_executor()->get_asio_executor());
+      io_context_lag_timers_.push_back(timer);
+      arm_io_context_lag_timer(std::move(timer));
+    }
+  }
+
+  void arm_io_context_lag_timer(
+      std::shared_ptr<asio::steady_timer> timer) {
+    static constexpr auto kSampleInterval = std::chrono::milliseconds(10);
+    const auto expected = std::chrono::steady_clock::now() + kSampleInterval;
+    timer->expires_at(expected);
+    timer->async_wait([this, timer = std::move(timer), expected](auto ec) {
+      if (ec || stop_timer_) {
+        return;
+      }
+      const auto now = std::chrono::steady_clock::now();
+      if (now > expected) {
+        const auto lag_us =
+            std::chrono::duration_cast<std::chrono::microseconds>(
+                now - expected).count();
+        detail::observe_io_context_lag(
+            static_cast<std::uint64_t>(lag_us));
+      }
+      arm_io_context_lag_timer(std::move(timer));
+    });
+  }
+
